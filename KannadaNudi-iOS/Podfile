platform :ios, '15.5'

target 'KannadaNudi' do
  use_frameworks!

  # No external dependencies currently required.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Force alignment with the app's deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      
      # Ensure architectures are handled correctly (Prevents x86_64 vs arm64 mismatch)
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      
      # Common fixes for Apple Silicon and modern Xcode
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
