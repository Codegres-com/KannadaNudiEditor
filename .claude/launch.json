{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nudiweb",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "KannadaNudiWeb/KannadaNudiWeb.csproj",
        "--urls",
        "http://localhost:5187"
      ],
      "port": 5187
    },
    {
      "name": "nudiweb-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5188",
        "--directory",
        "KannadaNudiWeb/wwwroot"
      ],
      "port": 5188
    }
  ]
}
