<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay that blocks WebView when Kannada Nudi keyboard is active -->
    <LinearLayout
        android:id="@+id/overlaySwitch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨️"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kannada Nudi Keyboard Detected"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvOverlayMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Editor (WebView) only accepts English input.\nPlease switch to an English keyboard (e.g. Gboard) to continue typing."
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSwitchKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#6200EE"
            android:text="🔄  Switch Input Method"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvOverlayHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Gboard or any English keyboard from the picker"
            android:textColor="#808080"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
