{
  "name": "kannadanudilinux",
  "version": "1.0.1",
  "description": "Kannada Nudi Editor desktop app for Linux / Ubuntu",
  "main": "main.js",
  "homepage": "https://codegres.com",
  "scripts": {
    "start": "electron .",
    "package": "node package-app.js",
    "dist:unpacked": "npm run package && electron-builder --linux --dir",
    "dist:tar": "npm run package && electron-builder --linux tar.gz",
    "dist:deb": "npm run dist:unpacked && node build-deb.js",
    "dist:snap": "npm run package && electron-builder --linux snap",
    "dist": "npm run package && electron-builder --linux tar.gz zip dir && node build-deb.js",
    "build-all": "npm run dist"
  },
  "keywords": [
    "kannada",
    "nudi",
    "editor",
    "text-editor",
    "desktop",
    "linux",
    "ubuntu",
    "snap"
  ],
  "author": {
    "name": "Codegres",
    "email": "contact@codegres.com"
  },
  "license": "ISC",
  "build": {
    "appId": "com.codegres.kannadanudi",
    "productName": "KannadaNudi",
    "files": [
      "main.js",
      "app/**/*",
      "icon.png"
    ],
    "linux": {
      "target": [
        "tar.gz",
        "zip",
        "dir"
      ],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "Codegres <contact@codegres.com>"
    },
    "snap": {
      "base": "core24",
      "confinement": "strict",
      "grade": "stable",
      "summary": "Offline Kannada Nudi Text Editor",
      "category": "Office;Utility;",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "wayland",
        "x11",
        "audio-playback",
        "home",
        "browser-support",
        "network",
        "network-bind"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
